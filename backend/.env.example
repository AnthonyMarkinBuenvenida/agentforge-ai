# Copy this file to .env and fill in your key.
# Leave ANTHROPIC_API_KEY blank to run in demo mode (no API calls, canned responses).
ANTHROPIC_API_KEY=

# Optional. Defaults to a local SQLite file if unset - fine for local development.
# In production (Vercel), the Neon Postgres integration injects this automatically
# as a postgresql:// URL; you do not need to set it yourself there.
DATABASE_URL=
