# Copy this file to .env and fill in your key(s).
# Leave both blank to run in demo mode (no API calls, canned responses).
# Provider priority if multiple keys are set: GEMINI_API_KEY, then ANTHROPIC_API_KEY, then demo mode.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Defaults to a local SQLite file if unset - fine for local development.
# In production (Vercel), the Neon Postgres integration injects this automatically
# as a postgresql:// URL; you do not need to set it yourself there.
DATABASE_URL=
